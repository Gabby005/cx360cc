# --- Database -----------------------------------------------------------
# Postgres connection string for YOUR database (Neon, Supabase, RDS, Aiven,
# Netlify DB / Neon integration, or self-hosted). Must be reachable from
# Netlify's build + runtime environment (i.e. not behind a private VPC
# unless you've peered it or are using a proxy like PgBouncer over TLS).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cx360?sslmode=require"

# Prisma needs a *non-pooled* direct connection for migrations if your
# primary DATABASE_URL is a pooled connection (e.g. via PgBouncer/Neon pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/cx360?sslmode=require"

# --- Auth -----------------------------------------------------------------
NEXTAUTH_URL="https://your-site.netlify.app"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="CX360"
DEFAULT_TENANT_SLUG="demo-bank"

# --- Optional: Redis (Upstash) for background jobs / rate limiting -------
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Optional: cron secret so /api/cron/sla-check can't be called publicly
CRON_SECRET="generate with: openssl rand -base64 32"
