# Copy to deploy/.env.production and fill in. Never commit the real file.

# --- Address staff will use (no trailing slash) ---
CX360_HOST=cx360.example.bank
NEXTAUTH_URL=https://cx360.example.bank

# --- Secrets (make each one long and random:  openssl rand -base64 32) ---
POSTGRES_PASSWORD=change-me
NEXTAUTH_SECRET=change-me
CRON_SECRET=change-me
CX360_INBOUND_TOKEN=change-me
CX360_TOKEN_KEY=change-me

# --- Hosting inside the bank network ---
CX360_ALLOW_INTERNAL_URLS=true
TZ=Africa/Lagos

# --- Optional channel secrets (see Admin -> Channels for what each is for) ---
# CX360_META_VERIFY_TOKEN=
# CX360_META_APP_SECRET=
# CX360_WHATSAPP_TOKEN=
# CX360_META_PAGE_TOKEN=
# CX360_X_CLIENT_ID=
# CX360_X_CLIENT_SECRET=
# CX360_GRAPH_CLIENT_SECRET=
# Gateway/core-banking keys are referenced in Admin as {{secret:NAME}} and set here as CX360_NAME, e.g.:
# CX360_SMS_API_KEY=
# CX360_CORE_API_KEY=
